{
  "name": "platform",
  "version": "0.0.0",
  "private": true,
  "description": "Certivo — multi-tenant SaaS core platform for issuing and verifying certificates. See src/config/brand.ts.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed-default-institute.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fontkit": "^2.0.4",
    "jsqr": "^1.4.0",
    "next": "15.1.11",
    "pdf-lib": "1.17.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/fontkit": "^2.0.9",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "@vitest/coverage-v8": "2.1.8",
    "dotenv": "16.4.7",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.6",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "prisma": "6.2.1",
    "tailwindcss": "^4.1.12",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
