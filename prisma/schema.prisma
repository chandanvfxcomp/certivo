// ---------------------------------------------------------------------------
// 7.3 Certificate — brought forward from "Phase 2" by explicit user request
// (see the SCOPE CHANGE note at the top of this file). Deliberately NOT the
// full template engine the original spec sketched (no CertificateTemplate,
// CertificateField, SignatoryProfile, per-tenant layout editor) — those are
// still deferred. This is the minimal shape needed for "admin registers a
// student → a certificate exists with a unique code → the student can
// download it as a PDF → anyone can verify the code publicly":
//
//   - `code` is the frozen credential-code contract (Section 4):
//     <TENANT_PREFIX>-<YEAR>-<RANDOM10>, immutable once issued.
//   - The public verification page (`/v/{code}`) must NEVER expose Student's
//     PII (email, phone, address, DOB, photo, guardian name) — Section 11.
//     Rather than trust every future query to remember that filter, the
//     safe-to-show fields are SNAPSHOT onto Certificate itself at issuance
//     time (studentNameSnapshot / instituteNameSnapshot / courseNameSnapshot
//     / completionDate), and the verification page reads ONLY those columns,
//     through a dedicated Postgres view (`certificate_public`, migration
//     20260910_certificate) that a public request can query without ever
//     touching the `student` table or needing app.tenant_id set. See that
//     migration's comment for exactly how the view stays safe under RLS.
model Certificate {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  studentId String   @map("student_id") @db.Char(26)

  code   String             @unique // <TENANT_PREFIX>-<YEAR>-<RANDOM10>, frozen once issued
  status CertificateStatus  @default(ACTIVE)

  // Snapshot at issuance — the ONLY fields the public verification view may
  // read. Never re-derive these from a live join against `student`/`tenant`;
  // that would defeat the point of snapshotting them.
  studentNameSnapshot   String    @map("student_name_snapshot")
  instituteNameSnapshot String    @map("institute_name_snapshot")
  courseNameSnapshot    String    @map("course_name_snapshot")
  completionDate        DateTime? @map("completion_date") @db.Timestamptz
  // 2026-10-04: printed on the certificate (MODE / GRADE row of the
  // template). Snapshotted like the other display fields.
  grade String? @map("grade")
  mode  String? @map("mode")

  issuedAt      DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  revokedReason String?   @map("revoked_reason")

  // 2026-10-04: download gating — every certificate gets
  // FREE_DOWNLOADS_PER_PAYMENT free downloads
  // (src/config/certificate.ts); after those are used up, each further
  // download costs the ₹299 platform fee (PLATFORM_REDOWNLOAD_FEE_PAISE).
  // Incremented by student/(protected)/portal/certificate/route.ts on
  // each successful download.
  downloadCount Int @default(0) @map("download_count")

  // 2026-10-04: platform re-download fee — ₹299
  // (PLATFORM_REDOWNLOAD_FEE_PAISE, src/config/certificate.ts), the
  // platform's own revenue per the user's explicit instruction. After the
  // free download allowance is exhausted, the student pays this for a
  // fresh allowance — one payment unlocks exactly one download.
  platformFeePaid   Boolean   @default(false) @map("platform_fee_paid")
  platformFeePaidAt DateTime? @map("platform_fee_paid_at") @db.Timestamptz

  // 2026-10-04: opt-in public directory. When true, this certificate
  // appears in the searchable public directory (/directory) with only the
  // safe snapshot columns. Defaults to false (opt-in, not opt-out).
  directoryOptIn Boolean @default(false) @map("directory_opt_in")

  pdfFileId String? @map("pdf_file_id") @db.Char(26)

  createdBy String   @map("created_by") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([tenantId, studentId])
  @@map("certificate")
}

enum CertificateStatus {
  ACTIVE
  REVOKED

  @@map("certificate_status")
}

// Deferred, still not modelled: CertificateTemplate, CertificateField,
// CertificateRevocation (as its own audit table — revocation is inline on
// Certificate for now), SignatoryProfile. Bring these in when per-tenant
// certificate layouts / multi-signatory workflows are actually needed.
