# Copy to .env and fill in. Never commit .env.
#
# DATABASE_URL: pooled connection, used by the app at runtime as `app_user`
#   (RLS-enforced — see prisma/migrations/*_roles_and_rls). On Neon this is
#   the pooled connection string (port 6543 / "-pooler" host).
# DIRECT_URL: unpooled connection, used only for `prisma migrate` as
#   `migrator` (BYPASSRLS). On Neon this is the direct (non-pooled)
#   connection string.
#
# Local dev (this repo's own scripts/setup-db-roles.sql target):
DATABASE_URL="postgresql://app_user:app_user_dev_password@localhost:5432/platform_dev?schema=public"
DIRECT_URL="postgresql://migrator:migrator_dev_password@localhost:5432/platform_dev?schema=public"

# Node environment
NODE_ENV="development"

# SESSION_SECRET: HMAC key signing admin/student login cookies
# (src/server/auth/session.ts). Generate a real one locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the placeholder below outside local dev.
SESSION_SECRET="dev-only-placeholder-change-me-please-1234567890"

# DEFAULT_TENANT_SLUG / DEFAULT_ADMIN_EMAIL / DEFAULT_ADMIN_PASSWORD: used
# once by scripts/seed-default-institute.ts (the "single default institute"
# the feature-first MVP registers students under, until multi-institute
# onboarding is built). Change the password before running against
# anything but a local/dev database.
DEFAULT_TENANT_SLUG="default-institute"
DEFAULT_TENANT_NAME="Default Institute"
DEFAULT_TENANT_PREFIX="INST"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_NAME="Admin"
DEFAULT_ADMIN_PASSWORD="change-me-please-123"

# SUPER_ADMIN_EMAIL / SUPER_ADMIN_NAME / SUPER_ADMIN_PASSWORD: optional.
# When set, scripts/seed-default-institute.ts creates a platform Super Admin
# (User.isSuperAdmin) who approves/rejects/suspends institutes at
# /super-admin/login. Leave unset for single-institute deployments.
#SUPER_ADMIN_EMAIL="superadmin@example.com"
#SUPER_ADMIN_NAME="Super Admin"
#SUPER_ADMIN_PASSWORD="change-me-please-123"

# Email (transactional: download confirmations, etc.)
# EMAIL_PROVIDER: "console" (default — logs only, nothing sent) or "resend".
# For "resend": set RESEND_API_KEY and EMAIL_FROM, then EMAIL_PROVIDER="resend".
#EMAIL_PROVIDER="console"
#RESEND_API_KEY="re_..."
#EMAIL_FROM="noreply@yourdomain.com"

# Razorpay (online payments — replaces the manual mark-paid flow when set)
# Get these from the Razorpay dashboard. Until set, the app keeps the manual
# mark-paid buttons. Webhook URL to configure: https://yourdomain.com/api/payments/razorpay/webhook
#RAZORPAY_KEY_ID="rzp_test_..."
#RAZORPAY_KEY_SECRET="..."
#RAZORPAY_WEBHOOK_SECRET="..."

# Cashfree (alternative gateway — super admin picks the active one via
# AppSetting "payments.provider"). Get from the Cashfree dashboard (PG section).
# CASHFREE_ENV="sandbox" for testing, "production" for live.
# Webhook URL to configure: https://yourdomain.com/api/payments/cashfree/webhook
#CASHFREE_CLIENT_ID="..."
#CASHFREE_CLIENT_SECRET="..."
#CASHFREE_WEBHOOK_SECRET="..."
#CASHFREE_ENV="sandbox"

# Cron automation (GitHub Actions hits /api/cron/send-followups daily)
# Generate: openssl rand -hex 32
#CRON_SECRET="..."
